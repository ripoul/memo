{
  "name": "memo",
  "version": "1.0.0",
  "description": "My personal docs and memo",
  "repository": "https://github.com/ripoul/memo",
  "author": "ripoul",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "deploy": "docusaurus deploy",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "dependencies": {
    "@docusaurus/core": "^3.0.0",
    "@docusaurus/plugin-content-docs": "^3.10.1",
    "@docusaurus/plugin-pwa": "^3.10.1",
    "@docusaurus/preset-classic": "^3.0.0",
    "@easyops-cn/docusaurus-search-local": "^0.55.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.0.0",
    "@docusaurus/tsconfig": "^3.0.0",
    "@docusaurus/types": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=18.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 3 safari version"
    ]
  },
  "lint-staged": {
    "{eslint.config.js,prettier.config.mjs,docusaurus.config.ts,sidebars.ts,src/**/*.ts,src/**/*.tsx,plugins/**/*.js}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "{package.json,tsconfig*.json,docs/**/*.md,**/*.md,**/*.yml,**/*.yaml,static/**/*.svg,src/**/*.css}": "prettier --write"
  }
}
